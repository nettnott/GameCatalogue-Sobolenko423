<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === ПАЛИТРА ЦВЕТОВ: СВЕТЛАЯ РОЗОВАЯ ТЕМА === -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF5F7"/>
    <!-- Очень светлый розово-белый фон всей страницы -->

    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <!-- Чистый белый для карточек и панелей -->

    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFB6C1"/>
    <!-- Нежно-розовая рамка (LightPink) -->

    <SolidColorBrush x:Key="ImageBgBrush" Color="#FCE4EC"/>
    <!-- Светло-розовая подложка под картинки -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF8FA3"/>
    <!-- Основной розовый цвет для рамок и акцентов -->

    <SolidColorBrush x:Key="AccentBrush" Color="#FF6B8B"/>
    <!-- Более насыщенный розовый для кнопок и важных элементов -->

    <SolidColorBrush x:Key="TextBrush" Color="#5D4037"/>
    <!-- Теплый темно-коричневый для текста (мягче черного) -->

    <SolidColorBrush x:Key="PriceBrush" Color="#E91E63"/>
    <!-- Яркий малиновый для цен -->

    <!-- Фон страниц -->
    <Style TargetType="Page">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    </Style>

    <!-- Фон окна -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    </Style>

    <!-- Стилизация ListBoxItem, убирается выделение -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для Кнопок -->
    <Style TargetType="Button">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="15,5"/>
        <Setter Property="Margin" Value="10,8"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12pt"/>
        <Setter Property="FontWeight" Value="Bold"/>

        <!-- Белый фон кнопки с розовой обводкой -->
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Стиль для Полей ввода текста с поддержкой Tag-плейсхолдера -->
    <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>

        <!-- Переопределяем шаблон элемента, чтобы засунуть внутрь текст подсказки -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="8">
                        <!-- Сделал углы чуть более круглыми для мягкости -->
                        <Grid>
                            <!-- Стандартное поле, куда вводится текст -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                            <!-- А это наш плейсхолдер. Он привязан к свойству Tag -->
                            <TextBlock x:Name="placeholderText" 
                                   Text="{TemplateBinding Tag}" 
                                   Foreground="#BCAAA4" 
                                   FontStyle="Italic"
                                   VerticalAlignment="Center" 
                                   Margin="8,0"
                                   IsHitTestVisible="False" 
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- ТРИГГЕРЫ -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Убрал триггер на фокус, чтобы плейсхолдер пропадал только когда есть текст -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для Полей ввода пароля (Базовый) -->
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Выпадающих списков -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Текста -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Специальный стиль для PasswordBox с поддержкой плейсхолдера через Tag -->
    <Style x:Key="PlaceholderPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="8">
                        <Grid>
                            <!-- Стандартный контейнер для скрытых точек пароля -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                            <!-- Текст нашего плейсхолдера -->
                            <TextBlock x:Name="placeholderText" 
                                   Text="{TemplateBinding Tag}" 
                                   Foreground="#BCAAA4" 
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="False">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Глобавльный стиль для DATAGRID -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="RowBackground" Value="#FFFFFF"/>
        <Setter Property="AlternatingRowBackground" Value="#FFF0F5"/>
        <!-- LavenderBlush -->
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#F8BBD0"/>
        <!-- Светло-розовые линии -->
    </Style>

    <!-- Контрастный стиль для шапки таблицы -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FFCDD2"/>
        <!-- Нежный розовый фон шапки -->
        <Setter Property="Foreground" Value="#880E4F"/>
        <!-- Темно-розовый текст -->
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,2"/>
    </Style>

    <!-- Стиль для чекбоксов -->
    <Style TargetType="CheckBox">
        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>