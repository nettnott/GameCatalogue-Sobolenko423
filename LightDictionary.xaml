<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра цветов темы -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF5F5"/>
    <!-- Нежно-розовый общий фон -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <!-- Белый фон карточек игр -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
    <!-- Светлая рамка карточки -->
    <SolidColorBrush x:Key="ImageBgBrush" Color="#EDF2F7"/>
    <!-- Фон заглушки под картинку -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFD1D1"/>
    <!-- Пастельный розовый для кнопок -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7B7B"/>
    <!-- Яркий коралловый -->
    <SolidColorBrush x:Key="TextBrush" Color="#4A2E2E"/>
    <!-- Темно-коричневый текст -->
    <SolidColorBrush x:Key="PriceBrush" Color="#38A169"/>
    <!-- Зеленая цена для светлой темы -->

    <!-- Автоматический фон страниц -->
    <Style TargetType="Page">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    </Style>

    <!-- Стилизация ListBoxItem (убираем синее выделение при клике) -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для Кнопок -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="15,5"/>
        <Setter Property="Margin" Value="10,8"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12pt"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- Стиль для Текстовых полей -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#FFC0C0"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Выпадающих списков -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="#FFC0C0"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Текста -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
</ResourceDictionary>