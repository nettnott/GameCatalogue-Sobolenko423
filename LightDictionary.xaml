<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра цветов темы -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF5F5"/>
    <!-- Нежно-розовый общий фон -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <!-- Белый фон карточек игр -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
    <!-- Светлая рамка карточки -->
    <SolidColorBrush x:Key="ImageBgBrush" Color="#EDF2F7"/>
    <!-- Фон заглушки под картинку -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFD1D1"/>
    <!-- Пастельный розовый для кнопок -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7B7B"/>
    <!-- Яркий коралловый -->
    <SolidColorBrush x:Key="TextBrush" Color="#4A2E2E"/>
    <!-- Темно-коричневый текст -->
    <SolidColorBrush x:Key="PriceBrush" Color="#38A169"/>
    <!-- Зеленая цена для светлой темы -->

    <!-- Автоматический фон страниц -->
    <Style TargetType="Page">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    </Style>

    <!-- Стилизация ListBoxItem (убираем синее выделение при клике) -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для Кнопок -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="15,5"/>
        <Setter Property="Margin" Value="10,8"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12pt"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- Стиль для Текстовых полей -->
    <!-- Стиль для TextBox с поддержкой свойства Tag в качестве плейсхолдера -->
    <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- Переопределяем шаблон элемента, чтобы засунуть внутрь текст подсказки -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4">
                        <Grid>
                            <!-- Стандартное поле, куда вводится текст -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                            <!-- А это наш плейсхолдер. Он привязан к свойству Tag -->
                            <TextBlock x:Name="placeholderText" 
                                   Text="{TemplateBinding Tag}" 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   VerticalAlignment="Center" 
                                   Margin="8,0"
                                   IsHitTestVisible="False" 
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- ТРИГГЕРЫ: Самая магия происходит здесь -->
                    <ControlTemplate.Triggers>
                        <!-- Если текст в TextBox пустой, показываем плейсхолдер -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Если поле получает фокус клавиатуры (кликнули мышкой) — прячем плейсхолдер -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для Выпадающих списков -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="#FFC0C0"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Текста -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Специальный стиль для PasswordBox с поддержкой плейсхолдера через Tag -->
    <Style x:Key="PlaceholderPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4">
                        <Grid>
                            <!-- Стандартный контейнер для скрытых точек пароля -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                            <!-- Текст нашего плейсхолдера -->
                            <TextBlock x:Name="placeholderText" 
                                   Text="{TemplateBinding Tag}" 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   VerticalAlignment="Center" 
                                   Margin="8,0"
                                   IsHitTestVisible="False" 
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Когда поле НЕ в фокусе (пользователь туда не кликнул), показываем подсказку -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="False">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Когда пользователь кликнул в поле, мгновенно скрываем её -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>