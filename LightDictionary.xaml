<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Основные цвета темы -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF5F5"/>
    <!-- Нежно-розовый фон -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <!-- Белые карточки/панели -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFD1D1"/>
    <!-- Пастельный розовый для кнопок -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7B7B"/>
    <!-- Яркий коралловый для акцентов -->
    <SolidColorBrush x:Key="TextBrush" Color="#4A2E2E"/>
    <!-- Темно-коричневый мягкий текст -->

    <!-- Стиль для Кнопок -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12pt"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Стиль для Текстовых полей -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#FFC0C0"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Выпадающих списков -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="#FFC0C0"/>
    </Style>

    <!-- Стиль для Обычного Текста -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
</ResourceDictionary>