<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Основные цвета темы -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0E14"/>
    <!-- Глубокий темный фон -->
    <SolidColorBrush x:Key="PanelBrush" Color="#161A23"/>
    <!-- Темно-серые неоновые панели -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#006B80"/>
    <!-- Неоновый сине-зеленый -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FCEE09"/>
    <!-- Киберпанк желтый -->
    <SolidColorBrush x:Key="TextBrush" Color="#00FFCC"/>
    <!-- Токсично-бирюзовый текст -->

    <!-- Стиль для Кнопок -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12pt"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <!-- Желтый текст -->
        <Setter Property="BorderBrush" Value="{StaticResource TextBrush}"/>
        <!-- Бирюзовая рамка -->
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Стиль для Текстовых полей -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Background" Value="#0B0E14"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Выпадающих списков -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Стиль для Обычного Текста -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
</ResourceDictionary>