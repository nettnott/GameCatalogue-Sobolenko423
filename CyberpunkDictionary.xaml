<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === ПАЛИТРА ЦВЕТОВ: ТЕМНАЯ КИБЕРПАНК ТЕМА === -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0E14"/>
    <!-- Глубокий темный фон всей страницы -->

    <SolidColorBrush x:Key="PanelBrush" Color="#161A23"/>
    <!-- Темные карточки и панели -->

    <SolidColorBrush x:Key="CardBorderBrush" Color="#00FFCC"/>
    <!-- Неоновая рамка карточек -->

    <SolidColorBrush x:Key="ImageBgBrush" Color="#0F121A"/>
    <!-- Темная подложка под обложки -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="#006B80"/>
    <!-- Основной сине-зеленый цвет для рамок -->

    <SolidColorBrush x:Key="AccentBrush" Color="#FCEE09"/>
    <!-- Желтый акцент для кнопок и важных элементов -->

    <SolidColorBrush x:Key="TextBrush" Color="#00FFCC"/>
    <!-- Неоново-бирюзовый текст -->

    <SolidColorBrush x:Key="PriceBrush" Color="#FCEE09"/>
    <!-- Желтая цена -->

    <!-- Фон страниц -->
    <Style TargetType="Page">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    </Style>

    <!-- Фон окна -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    </Style>

    <!-- Стилизация ListBoxItem, убирается выделение -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для Кнопок -->
    <Style TargetType="Button">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="15,5"/>
        <Setter Property="Margin" Value="10,8"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="12pt"/>
        <Setter Property="FontWeight" Value="Bold"/>

        <!-- Темный фон кнопки с неоновой обводкой -->
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Стиль для Полей ввода текста с поддержкой Tag-плейсхолдера -->
    <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Background" Value="#0B0E14"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>

        <!-- Переопределяем шаблон элемента, чтобы засунуть внутрь текст подсказки -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4">
                        <Grid>
                            <!-- Стандартное поле, куда вводится текст -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                            <!-- А это наш плейсхолдер. Он привязан к свойству Tag -->
                            <TextBlock x:Name="placeholderText" 
                                   Text="{TemplateBinding Tag}" 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   VerticalAlignment="Center" 
                                   Margin="8,0"
                                   IsHitTestVisible="False" 
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- ТРИГГЕРЫ -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для Полей ввода пароля (Базовый) -->
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="Background" Value="#0B0E14"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Выпадающих списков -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стиль для Текста -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Специальный стиль для PasswordBox с поддержкой плейсхолдера через Tag -->
    <Style x:Key="PlaceholderPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="Background" Value="#0B0E14"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4">
                        <Grid>
                            <!-- Стандартный контейнер для скрытых точек пароля -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                            <!-- Текст нашего плейсхолдера -->
                            <TextBlock x:Name="placeholderText" 
                                   Text="{TemplateBinding Tag}" 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Логика: показываем плейсхолдер ТОЛЬКО если пароль пустой -->
                        <Trigger Property="IsFocused" Value="False">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для DATAGRID -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="RowBackground" Value="#11141C"/>
        <Setter Property="AlternatingRowBackground" Value="#161A23"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <!-- Контрастный стиль для шапки таблицы -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#1F2633"/>
        <!-- Темно-серый фон шапки -->
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <!-- Неоново-бирюзовый текст -->
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,2"/>
    </Style>

    <!-- Стиль для чекбоксов -->
    <Style TargetType="CheckBox">
        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="11pt"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>