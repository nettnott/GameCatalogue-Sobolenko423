<Window x:Class="GameCatalogue.MainWindow" Icon="/res/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        xmlns:local="clr-namespace:GameCatalogue"
        mc:Ignorable="d" 
        Title="nottgames" Width="1200" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="NOTTGAMES" FontSize="24" FontWeight="Bold"/>
            <Button x:Name="BTNcatalogue" ToolTip="Каталог игр" Content="Каталог" Click="BTNcatalogue_Click" Margin="0, 20"/>
            <Button x:Name="BTNaccount" ToolTip="Аккаунт" Content="Аккаунт" Click="BTNaccount_Click" Margin="0, 20"/>
            <Button x:Name="BTNadmin" ToolTip="Администрирование" Content="Админка" Click="BTNadmin_Click" Margin="0, 20"/>
            <Button x:Name="BTNLogout" ToolTip="Выйти из аккаунта" Content="Выйти из аккаунта" Click="BTNLogout_Click" Margin="0, 20"/>

            <CheckBox x:Name="ChbTheme" HorizontalAlignment="Center" ToolTip="Сменить тему" Content="Темная тема" Checked="ChbTheme_Checked" Unchecked="ChbTheme_Unchecked"/>
        </StackPanel>

        <TextBlock x:Name="TBDateTime" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

        <Frame Grid.Column="0" x:Name="MainFrame" NavigationUIVisibility="Hidden" Margin="10"/>
    </Grid>
</Window>
