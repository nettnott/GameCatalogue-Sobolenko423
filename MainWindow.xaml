<Window x:Class="GameCatalogue.MainWindow" Icon="/res/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameCatalogue"
        mc:Ignorable="d"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="NOTTGAMES" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,30,0,40"/>
            <Button x:Name="BTNcatalogue" Content="catalogue" Click="BTNcatalogue_Click"/>
            <Button x:Name="BTNaccount" Content="account" Click="BTNaccount_Click"/>
            <Button x:Name="BTNadmin" Content="admin" Click="BTNadmin_Click"/>
            <Button x:Name="BTNLogout" Content="Выйти" Click="BTNLogout_Click" Margin="0,50,0,0" Background="#FF4D8C"/>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="10"/>

        <!-- Нижняя строка: Дата и время -->
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TBDateTime" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
