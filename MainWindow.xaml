<Window x:Class="GameCatalogue.MainWindow" Icon="/res/icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameCatalogue"
        mc:Ignorable="d"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <Button x:Name="LogInBTN" Content="Войти" Click="LogInBTN_Click"/>
            <Button x:Name="BackBTN" Content="Назад" Click="BackBTN_Click"/>
            <TextBlock Style="{StaticResource HeaderText}">бебебеБУБУБУ</TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBox></TextBox>
            <CheckBox></CheckBox>
        </StackPanel>
        <Frame Grid.Row="1" Grid.Column="0" x:Name="MainFrame"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TBDateTime" HorizontalAlignment="Center"/>
    </Grid>
</Window>
