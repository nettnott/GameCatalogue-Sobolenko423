<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    Background - #0B0C10
    Карточки/блоки (Графитовый) - #1F2128 - Подложка под постеры игр, плашки меню
    Главный акцент (красный) - #990000 - Главные кнопки (Купить/Скачать), важные уведомления
    Второй акцент (Винный / Бордо) - #5F0909 - Состояние кнопок при нажатии, теги категорий
    Текст заголовков (Платиновый) - #E5E7EB - Названия игр, крупные разделы
    Обычный текст (Пепельно-серый) - #9CA3AF - Описание игр, системные требования, даты
    -->
    <!-- ЦВЕТОВАЯ ПАЛИТРА -->
    <SolidColorBrush x:Key="BgColor" Color="#0B0C10"/>
    <SolidColorBrush x:Key="CardColor" Color="#1F2128"/>
    <SolidColorBrush x:Key="MainAccentColor" Color="#990000"/>
    <SolidColorBrush x:Key="SecondAccentColor" Color="#5F0909"/>
    <SolidColorBrush x:Key="HeaderTextColor" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="MainTextColor" Color="#9CA3AF"/>

    <!-- СТИЛЬ ДЛЯ ОКНА (WINDOW) -->
    <Style TargetType="Window">
        <Setter Property="Width" Value="1920"/>
        <Setter Property="Height" Value="1080"/>
        <Setter Property="Title" Value="NottCatalogue"/>
        <Setter Property="Background" Value="{StaticResource BgColor}"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource MainTextColor}"/>
    </Style>

    <!-- СТИЛЬ ДЛЯ ЗАГОЛОВКОВ (TEXTBLOCK) -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Palatino Linotype"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource HeaderTextColor}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ОБЫЧНЫЙ ТЕКСТ (По умолчанию для всех TextBlock в приложении) -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="Foreground" Value="{StaticResource MainTextColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- СТИЛЬ ДЛЯ КНОПОК (BUTTON) -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Width" Value="120"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Background" Value="{StaticResource SecondAccentColor}"/>
        <Setter Property="Foreground" Value="{StaticResource HeaderTextColor}"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MainAccentColor}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- СТИЛЬ ДЛЯ ПОЛЕЙ ВВОДА (TEXTBOX) -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Background" Value="{StaticResource CardColor}"/>
        <Setter Property="Foreground" Value="{StaticResource HeaderTextColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SecondAccentColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- СТИЛЬ ДЛЯ ЧЕКБОКСОВ (CHECKBOX) -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource MainTextColor}"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0"/>
    </Style>

    <!-- СТИЛЬ ДЛЯ САМОГО КОНТЕЙНЕРА LISTBOX -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BgColor}"/>
        <!-- Темный фон всего списка -->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <!-- Отключаем горизонтальный скролл для плиточной сетки -->
    </Style>

    <!-- СТИЛЬ ДЛЯ ЭЛЕМЕНТОВ LISTBOX (КАРТОЧЕК ИГР) -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource CardColor}"/>
        <!-- Графитовая подложка под игру -->
        <Setter Property="Foreground" Value="{StaticResource MainTextColor}"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Style.Triggers>
            <!-- Эффект при наведении на карточку игры (Винный бордовый контур) -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SecondAccentColor}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>

            <!-- Эффект при выборе (клике) на карточку игры (Красная подсветка) -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondAccentColor}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MainAccentColor}"/>
                <Setter Property="Foreground" Value="{StaticResource HeaderTextColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>