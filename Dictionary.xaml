<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    Background - #0B0C10
    Карточки/блоки (Графитовый) - #1F2128 - Подложка под постеры игр, плашки меню
    Главный акцент (красный) - #990000 - Главные кнопки (Купить/Скачать), важные уведомления
    Второй акцент (Винный / Бордо) - #5F0909 - Состояние кнопок при нажатии, теги категорий
    Текст заголовков (Платиновый) - #E5E7EB - Названия игр, крупные разделы
    Обычный текст (Пепельно-серый) - #9CA3AF - Описание игр, системные требования, даты
    -->
    <Style TargetType="Window">
        <Setter Property="Width" Value="1920"/>
        <Setter Property="Height" Value="1080"/>
        <Setter Property="Title" Value="NottCatalogue"/>
        <Setter Property="Background" Value="#0B0C10"/>
    </Style>
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Palatino Linotype"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="Foreground" Value="#E5E7EB"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="#5F0909"/>
        <Setter Property=""
    </Style>

</ResourceDictionary>