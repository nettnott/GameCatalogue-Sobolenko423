<Page x:Class="GameCatalogue.pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddUserPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. Логин -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Пароль -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Роль -->
            <RowDefinition Height="Auto"/>
            <!-- 3. ФИО -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Кнопки -->
        </Grid.RowDefinitions>

        <!-- Логин -->
        <StackPanel Grid.Row="0" Margin="0,5">
            <TextBlock Text="Логин"/>
            <TextBox x:Name="TBLogin" Text="{Binding Login}" ToolTip="Введите логин" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: MegaSigma"/>
        </StackPanel>

        <!-- Пароль -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Пароль"/>
            <TextBox x:Name="TBPass" Text="{Binding Password}" ToolTip="Введите пароль" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: 67mega67"/>
        </StackPanel>

        <!-- Роль -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Роль"/>
            <ComboBox x:Name="cmbRole" SelectedValue="{Binding Role}" SelectedValuePath="Content" ToolTip="Выберите роль">
                <ComboBoxItem Content="ADMIN" />
                <ComboBoxItem Content="USER" />
            </ComboBox>
        </StackPanel>

        <!-- ФИО -->
        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="ФИО"/>
            <TextBox x:Name="TBFio" Text="{Binding FIO}" ToolTip="Введите ФИО" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: Сигмов Сигма Сигмович"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="4">
            <Button x:Name="ButtonSave" ToolTip="Сохранить" Content="Сохранить" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" ToolTip="Очистить" Content="Очистить" Click="ButtonClean_Click"/>
            <Button x:Name="ButtonBack" ToolTip="Назад" Content="Назад" Click="ButtonBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
