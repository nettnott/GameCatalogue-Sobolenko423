<Page x:Class="GameCatalogue.pages.AddGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddGamePage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. Название -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Описание -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Цена -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Пользователь -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Категория -->
            <RowDefinition Height="Auto"/>
            <!-- 6. Кнопки -->
        </Grid.RowDefinitions>

        <!-- Название игры -->
        <StackPanel Grid.Row="0" Margin="0,5">
            <TextBlock Text="Название игры"/>
            <TextBox x:Name="TBGameName" ToolTip="Название игры" Text="{Binding Name}" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: MEGA-GIGa-KRUTOI shlak"/>
        </StackPanel>

        <!-- Описание -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Описание"/>
            <TextBox x:Name="TBDescription" ToolTip="Описание игры" Text="{Binding Description}" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: Все короче мега-гига-круто и нишево" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <!-- Цена -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Цена"/>
            <TextBox x:Name="TBPrice" ToolTip="Цена игры" Text="{Binding Price}" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: 67"/>
        </StackPanel>

        <!-- Пользователь -->
        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="Пользователь"/>
            <ComboBox x:Name="CBUser" SelectedValuePath="ID" ToolTip="Пользователь, добавивший игру" SelectedValue="{Binding UserID}"/>
        </StackPanel>

        <!-- Категория -->
        <StackPanel Grid.Row="4" Margin="0,5">
            <TextBlock Text="Категория (ID)" FontWeight="Bold"/>
            <ComboBox x:Name="CBCategory" SelectedValuePath="ID" ToolTip="Категория игры" SelectedValue="{Binding CategoryID}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="5">
            <Button x:Name="ButtonSave" ToolTip="Сохранить" Content="Сохранить" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" ToolTip="Очистить" Content="Очистить" Click="ButtonClean_Click"/>
            <Button x:Name="ButtonBack" ToolTip="Назад" Content="Назад" Click="ButtonBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
