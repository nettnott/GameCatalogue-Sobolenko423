<Page x:Class="GameCatalogue.pages.AddGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddGamePage">

    <Grid Margin="20">
        <!-- Делаем 7 строк для поочередного вывода всех полей и кнопок -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. Название -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Описание -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Цена -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Пользователь -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Категория -->
            <RowDefinition Height="20"/>
            <!-- 5. Небольшой отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 6. Кнопки -->
        </Grid.RowDefinitions>

        <!-- Каждое поле заворачиваем в StackPanel, чтобы подпись была над полем ввода -->

        <!-- Название игры -->
        <StackPanel Grid.Row="0" Margin="0,5">
            <TextBlock Text="Название игры" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TBGameName" ToolTip="Название игры" Text="{Binding Name}" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Описание -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Описание" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TBDescription" ToolTip="Описание игры" Text="{Binding Description}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <!-- Цена -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Цена" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TBPrice" ToolTip="Цена игры" Text="{Binding Price}" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Пользователь -->
        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="Пользователь (ID)" FontWeight="Bold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CBUser" SelectedValuePath="ID" ToolTip="Пользователь, добавивший игру" SelectedValue="{Binding UserID}" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Категория -->
        <StackPanel Grid.Row="4" Margin="0,5">
            <TextBlock Text="Категория (ID)" FontWeight="Bold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CBCategory" SelectedValuePath="ID" ToolTip="Категория игры" SelectedValue="{Binding CategoryID}" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="5">
            <Button x:Name="ButtonSave" ToolTip="Сохранить" Content="Сохранить" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" ToolTip="Очистить" Content="Очистить" Click="ButtonClean_Click"/>
            <Button x:Name="ButtonBack" ToolTip="Назад" Content="Назад" Click="ButtonBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
