<Page x:Class="GameCatalogue.pages.AddGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddGamePage">

    <Grid Margin="20">
        <!-- Делаем 7 строк для поочередного вывода всех полей и кнопок -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0. Название -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Описание -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Цена -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Пользователь -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Категория -->
            <RowDefinition Height="20"/>
            <!-- 5. Небольшой отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 6. Кнопки -->
        </Grid.RowDefinitions>

        <!-- Каждое поле заворачиваем в StackPanel, чтобы подпись была над полем ввода -->

        <!-- Название игры -->
        <StackPanel Grid.Row="0" Margin="0,5">
            <TextBlock Text="Название игры" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TBGameName" Text="{Binding Name}" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Описание -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Описание" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TBDescription" Text="{Binding Description}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <!-- Цена -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Цена" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TBPrice" Text="{Binding Price}" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Пользователь -->
        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="Пользователь (ID)" FontWeight="Bold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CBUser" SelectedValuePath="ID" SelectedValue="{Binding UserID}" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Категория -->
        <StackPanel Grid.Row="4" Margin="0,5">
            <TextBlock Text="Категория (ID)" FontWeight="Bold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CBCategory" SelectedValuePath="ID" SelectedValue="{Binding CategoryID}" Height="25" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Блок кнопок в самом низу (Разделен на 2 колонки, чтобы кнопки стояли рядом) -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ButtonSave" Content="Сохранить" Grid.Column="0" Margin="0,0,10,0" Height="35" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить" Grid.Column="1" Margin="10,0,0,0" Height="35" Click="ButtonClean_Click"/>
        </Grid>
    </Grid>
</Page>
