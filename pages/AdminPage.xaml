<Page x:Class="GameCatalogue.pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
            <Button x:Name="BTNTabUsers" Content="Пользователи" ToolTip="Просмотр всех пользователей" Click="BTNTabUsers_Click" />
            <Button x:Name="BTNTabCategory" Content="Категории" ToolTip="Просмотр категорий" Click="BTNTabCategory_Click"/>
            <Button x:Name="BTNTabGames" Content="Игры" ToolTip="Просмотр игр" Click="BTNTabGames_Click"/>
            <Button x:Name="BTNDiagrams" Content="Диаграммы" ToolTip="Просмотр диаграмм" Click="BTNDiagrams_Click"/>

        </StackPanel>
    </Grid>
</Page>
