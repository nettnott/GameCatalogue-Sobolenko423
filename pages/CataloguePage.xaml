<Page x:Class="GameCatalogue.pages.CataloguePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="CataloguePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="TBSearch" ToolTip="Вы можете искать!!" Margin="20, 0" TextChanged="TBSearch_TextChanged" Width="350" Height="35" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Введите название игры"/>
            <ComboBox x:Name="CBSort" ToolTip="Выберите сортировку" Margin="20, 0" SelectionChanged="CBSort_SelectionChanged">
                <ComboBoxItem>A-Z</ComboBoxItem>
                <ComboBoxItem>Z-A</ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="CBFilter" ToolTip="Фильтр по жанру" Margin="20, 0" SelectionChanged="CBFilter_SelectionChanged"/>
        </StackPanel>

        <ListBox x:Name="LBCatalogue" Grid.Row="1" Margin="5" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" Background="{DynamicResource BackgroundBrush}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="15" CornerRadius="10" BorderThickness="1" Padding="15" Width="400" MinHeight="160" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource ImageBgBrush}" CornerRadius="6" ClipToBounds="True" >
                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                            </Border>
                            <Grid Grid.Column="1" Margin="15,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Name}"/>
                                <TextBlock Grid.Row="1" Text="{Binding Category.Name}" />
                                <TextBlock Grid.Row="2" Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60"/>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Price}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource PriceBrush}"/>
                                    <TextBlock Text=" ₽" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource PriceBrush}"/>
                                </StackPanel>

                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
