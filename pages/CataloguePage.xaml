<Page x:Class="GameCatalogue.pages.CataloguePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CataloguePage">

    <Grid>
        <!-- Сетка: 3 строки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <!-- Средняя строка (Основной контент / Страницы) -->
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
            <TextBox x:Name="TBSearch" TextChanged="TBSearch_TextChanged" Width="300" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
            <ListBox x:Name="LBCatalogue">
                
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
