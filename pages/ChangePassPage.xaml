<Page x:Class="GameCatalogue.pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChangePassPage">

    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Логин"/>
            <TextBox x:Name="TBLogin" ToolTip="Введите логин или почту" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: sasa"/>
            <Label Content="Старый пароль"/>
            <PasswordBox x:Name="PasswordBox" ToolTip="Введите старый пароль" Style="{StaticResource PlaceholderPasswordBoxStyle}" Tag="Например: PAST PASSWORD"/>
            <Label Content="Новый пароль"/>
            <PasswordBox x:Name="PasswordBoxBRANDNEW" ToolTip="Введите новый пароль" Style="{StaticResource PlaceholderPasswordBoxStyle}" Tag="Например: SUPER PASSWORD"/>
            <Label Content="Повторите новый пароль"/>
            <PasswordBox x:Name="PasswordBoxNEWCheck" ToolTip="Повторите новый пароль" Style="{StaticResource PlaceholderPasswordBoxStyle}" Tag="Например: SUPER PASSWORD"/>
            
            <Button x:Name="BTNChangePassword" Content="Сменить пароль" ToolTip="Нажмите, чтобы сменить пароль" Click="BTNChangePassword_Click"/>
            <Button x:Name="ButtonBack" Content="Назад" ToolTip="Назад" Click="ButtonBack_Click"/>

        </StackPanel>
    </Grid>
</Page>
