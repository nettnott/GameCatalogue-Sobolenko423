<Page x:Class="GameCatalogue.pages.LogInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d"
      Title="LogInPage">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
            <Label Content="Капча:" Visibility="Collapsed" Name="labelCaptcha"/>
            <TextBox 
                CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                ContextMenu="{x:Null}"
                Visibility="Collapsed"
                x:Name="captcha"
                Height="45"
                Foreground="Red"
                FontStyle="Italic"
                FontWeight="Heavy"
                VerticalAlignment="Top"
                Width="155"
                Background="{x:Null}"
                FontStretch="UltraCondensed"
                IsReadOnly="True"
                HorizontalContentAlignment="Center"
                FontSize="20" />
            <TextBox Visibility="Collapsed" x:Name="captchaInput" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Ввеедите текст с изображения" />
            <Button x:Name="submitCaptcha" Visibility="Collapsed" Content="Подтвердить" ToolTip="Подтвердить ввод капчи" Click="submitCaptcha_Click" />


            <Label Content="Логин" x:Name="labelLogin"/>
            <TextBox x:Name="TBLogin" ToolTip="Введите логин" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: sasa"/>
            <Label Content="Пароль" x:Name="labelPass"/>
            <PasswordBox x:Name="PasswordBox" ToolTip="Введите пароль"/>
            <Button x:Name="BTNEnter" Content="Войти" ToolTip="Нажмите, чтобы войти" Margin="0, 10" Click="BTNEnter_Click" />
            <Button x:Name="BTNReg" Content="Создать аккаунт" ToolTip="Нажмите, чтобы создать аккаунт" Margin="0, 10" Click="BTNReg_Click"/>
            <Button x:Name="BTNChangePassword" Content="Сменить пароль" ToolTip="Нажмите, чтобы сменить пароль" Margin="0,10" Click="BTNChangePassword_Click"/>
        </StackPanel>
    </Grid>
</Page>
