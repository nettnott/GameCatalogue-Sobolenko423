<Page x:Class="GameCatalogue.pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Введите логин" Margin="10"/>
            <Label Content="Выберите роль" Margin="10"/>
            <Label Content="Подтвердите пароль" Margin="10"/>
            <Label Content="Введите пароль" Margin="10"/>
            <Label Content="Введите ФИО" Margin="10"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBox x:Name="TBLog" ToolTip="Введите логин" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: sasa" />
            <ComboBox x:Name="CBRole" ToolTip="Выберите роль">
                <ComboBoxItem Content="USER" />
                <ComboBoxItem Content="ADMIN" />
            </ComboBox>
            <PasswordBox x:Name="passBxFrst" ToolTip="Введите пароль" Style="{StaticResource PlaceholderPasswordBoxStyle}" Tag="Например: 67SWAGA67"/>
            <PasswordBox x:Name="passBxScnd" ToolTip="Повторите пароль"  Style="{StaticResource PlaceholderPasswordBoxStyle}" Tag="Например: 67SWAGA67"/>
            <TextBox x:Name="TBFIO" ToolTip="Введите ФИО" Style="{StaticResource PlaceholderTextBoxStyle}" Tag="Например: Sasalelel Sasalow"/>
        </StackPanel>
        <Button Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" x:Name="regButton" ToolTip="Создать аккаунт" Content="Создать аккаунт" Click="regButton_Click"/> 
    </Grid>
</Page>
