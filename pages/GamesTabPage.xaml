<Page x:Class="GameCatalogue.pages.GamesTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamesTabPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="377*"/>
            <RowDefinition Height="73*"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="DataGridPayment" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="50"/>

                <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.FIO}" Width="80" />
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="50"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Num}" Width="70"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Price}" Width="80"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="80" />
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать данные" Click="ButtonEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1">
            <Button x:Name="ButtonAdd" ToolTip="Добавить данные" Margin="10,0,0,0" Height="30" Content="Добавить" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" ToolTip="Удалить данные" Margin="10,0,0,0" Height="30" Content="Удалить" Click="ButtonDel_Click"/>
            <Button x:Name="ButtonBack" Content="Назад" Margin="10,0,0,0" Height="30" Click="ButtonBack_Click"/>
        </StackPanel>

    </Grid>
</Page>
