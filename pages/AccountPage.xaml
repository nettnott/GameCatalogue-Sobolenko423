<Page x:Class="GameCatalogue.pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameCatalogue.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage">

    <Grid>
        <StackPanel x:Name="SPUser" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
            <Label Content="ФИО: "/>
            <TextBlock x:Name="TBFIO"/>
            <Label Content="Логин: "/>
            <TextBlock x:Name="TBLogin"/>
            <Label Content="Роль: "/>
            <TextBlock x:Name="TBRole"/>
            <Button x:Name="BTNChangePassword" Content="Сменить пароль" ToolTip="Нажмите, чтобы сменить пароль" Click="BTNChangePassword_Click"/>
        </StackPanel>
    </Grid>
</Page>
